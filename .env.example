# Copy to .env for local development.
MKDOCS_MCP_SITES=[{"name":"docs","base_url":"https://docs.example.com"}]
# Add more objects to the list for more sites. A site may include search_index_url.

MKDOCS_MCP_REINDEX_INTERVAL_MINUTES=30
MKDOCS_MCP_LOG_JSON=false
MKDOCS_MCP_LOG_LEVEL=INFO
MKDOCS_MCP_METRICS_ENABLED=false
