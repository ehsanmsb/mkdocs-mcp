# Copy to .env for local development. All vars are prefixed MKDOCS_MCP_.

# Source: point at a local checkout of any MkDocs docs repo for dev.
MKDOCS_MCP_SOURCE_MODE=local
MKDOCS_MCP_REPO_DIR=/path/to/your/mkdocs-repo
MKDOCS_MCP_MKDOCS_CONFIG=mkdocs.yml
MKDOCS_MCP_BASE_URL=https://docs.example.com

# Auth (use none for local dev; bearer everywhere else)
MKDOCS_MCP_AUTH_MODE=none
# MKDOCS_MCP_AUTH_MODE=bearer
# MKDOCS_MCP_BEARER_TOKENS=dev-token-1,dev-token-2
# MKDOCS_MCP_ADMIN_TOKENS=dev-admin-token

# Classification (optional)
# MKDOCS_MCP_TENANTS=["team-a","team-b"]
# MKDOCS_MCP_TOPICS_FILE=/etc/mkdocs-mcp/topics.yml
# MKDOCS_MCP_FEATURED_TOPICS=["kubernetes","argocd","terraform"]

# Index / snapshot
MKDOCS_MCP_SNAPSHOT_PATH=/tmp/mkdocs-mcp-index-snapshot.json
MKDOCS_MCP_REINDEX_INTERVAL_MINUTES=0

# Logging / metrics
MKDOCS_MCP_LOG_JSON=false
MKDOCS_MCP_LOG_LEVEL=INFO
MKDOCS_MCP_METRICS_ENABLED=false

# Semantic search (optional; needs the `vectors` extra)
# MKDOCS_MCP_EMBEDDINGS_ENABLED=true
# MKDOCS_MCP_EMBEDDINGS_MODEL=BAAI/bge-m3
