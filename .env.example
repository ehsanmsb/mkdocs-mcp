# Copy to .env for local development.
MKDOCS_MCP_BASE_URL=https://docs.example.com
# Override only if the published index is not at BASE_URL/search/search_index.json.
# MKDOCS_MCP_SEARCH_INDEX_URL=https://docs.example.com/custom/search_index.json
# For multiple sites, use JSON. This replaces BASE_URL and SEARCH_INDEX_URL.
# MKDOCS_MCP_SITES=[{"name":"atlas","base_url":"https://atlas.example.com"},{"name":"team","base_url":"https://team.example.com"}]

MKDOCS_MCP_REINDEX_INTERVAL_MINUTES=30
MKDOCS_MCP_LOG_JSON=false
MKDOCS_MCP_LOG_LEVEL=INFO
MKDOCS_MCP_METRICS_ENABLED=false
